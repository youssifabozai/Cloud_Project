		{
			"name": "Auth",
			"description": "Authentication endpoints — login, create user, and logout.\n\nLogin is public; create-user requires MANAGER/ADMIN; logout requires a valid token.",
			"item": [
				{
					"name": "Login (POST /auth/login)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const json = pm.response.json();",
									"if (json.accessToken) {",
									"    pm.collectionVariables.set('bearerToken', json.accessToken);",
									"    console.log('✅ bearerToken auto-saved');",
									"}",
									"if (json.user && json.user.userId) {",
									"    pm.collectionVariables.set('userId', json.user.userId);",
									"    console.log('✅ userId auto-saved: ' + json.user.userId);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@minijira.com\",\n  \"password\": \"YourPassword123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						},
						"auth": { "type": "noauth" },
						"description": "Public. Authenticates against AWS Cognito and returns access/refresh tokens.\n\n**Auto-script**: On success, automatically sets `bearerToken` and `userId` collection variables."
					}
				},
				{
					"name": "Create User (POST /auth/create-user)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"newuser@minijira.com\",\n  \"password\": \"TempPassword123!\",\n  \"fullName\": \"New User\",\n  \"role\": \"Employee\",\n  \"team\": \"{{teamId}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/create-user",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "create-user"]
						},
						"description": "Requires MANAGER or ADMIN role. Creates a new user in Cognito and DynamoDB."
					}
				},
				{
					"name": "Logout (POST /auth/logout)",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/auth/logout",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "logout"]
						},
						"description": "Requires Bearer token. Invalidates the current access token in Cognito."
					}
				}
			]
		},
