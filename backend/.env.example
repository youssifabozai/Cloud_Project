AWS_REGION=us-east-1

COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=

# Auth guard: cache resolved user per Cognito sub (ms). Default 604800000 = 7 days
AUTH_CACHE_TTL_MS=604800000

TABLE_USERS=MiniJira-Users
TABLE_TEAMS=MiniJira-Teams
TABLE_PROJECTS=MiniJira-Projects
TABLE_TASKS=mini-jira-Tasks
TABLE_COMMENTS=mini-jira-comments
TABLE_ACTIVITY_LOG=mini-jira-ActivityLog

ORIGINAL_IMAGES_BUCKET=mini-jira-original-images-cc-project
RESIZED_IMAGES_BUCKET=mini-jira-resized-images-cc-project

SNS_TOPIC_ARN=
SQS_QUEUE_URL=

# CloudWatch custom metrics (mini-jira-dashboard widgets)
CLOUDWATCH_METRICS_ENABLED=true
CLOUDWATCH_METRICS_NAMESPACE=MiniJira
# EC2 CPU widget (optional)
EC2_INSTANCE_ID=
